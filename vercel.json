{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://collabsphere-1-p40p.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://collabsphere-1-p40p.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
