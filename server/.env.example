# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and public share link generation)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/collabsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/collabsphere

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# File Storage Configuration (local | cloudinary)
UPLOAD_STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Cloudinary (Optional - required only if UPLOAD_STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
